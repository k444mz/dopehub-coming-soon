# /etc/dopehub-signup/env  (root only, chmod 600). Put values with special characters in single quotes.
ADMIN_SECRET=generated-by-install-script
PUBLIC_URL=https://dopehub.net
# Outgoing email. relay = Oracle Email Delivery through the demo server (in use since 28 Sep 2026).
# RELAY_TOKEN is the RELAY_TOKEN value from /opt/dopehub/.env on dopehub-server.
MAIL_TRANSPORT=relay
RELAY_URL=https://demo.dopehub.net/relay/email
RELAY_TOKEN=
# smtp = the hosting.com mailbox no-reply@dopehub.net (the old way; set MAIL_TRANSPORT=smtp to use it)
SMTP_HOST=mail.dopehub.net
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=no-reply@dopehub.net
SMTP_PASS=
MAIL_FROM=no-reply@dopehub.net
MAIL_FROM_NAME=DopeHub.net
REPLY_TO=contact@dopehub.net
ALERT_TO=contact@dopehub.net

# Individual beta invitations are disabled until the approved access origin is configured.
# Supply each real invitation URL through tools/mail_campaign.py after access is approved.
BETA_INVITE_ORIGIN=
# Local file-only email preview (never use preview transport for production delivery).
# MAIL_TRANSPORT=preview
# MAIL_PREVIEW_DIR=/absolute/local/preview/emails
